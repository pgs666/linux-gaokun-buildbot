+		.name = "himax-spi",
+		.of_match_table = himax_spi_of_match,
+	},
+	.probe = himax_spi_probe,
+	.remove = himax_spi_remove,
+	.id_table = himax_spi_ids,
+};
+module_spi_driver(himax_spi_driver);
