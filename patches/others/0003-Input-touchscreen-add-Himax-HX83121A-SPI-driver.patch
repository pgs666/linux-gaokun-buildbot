 drivers/input/touchscreen/himax-spi-hw.c      | 906 ++++++++++++++++++
 drivers/input/touchscreen/himax-spi-sysfs.c   | 684 +++++++++++++
 drivers/input/touchscreen/himax-spi.h         | 192 ++++
 drivers/input/touchscreen/hx-algo-detect.c    | 751 +++++++++++++++
 drivers/input/touchscreen/hx-algo-internal.h  |  23 +
 .../input/touchscreen/hx-algo-preprocess.c    | 479 +++++++++
 drivers/input/touchscreen/hx-algo-resolve.c   | 310 ++++++
 drivers/input/touchscreen/hx-algo-track.c     | 699 ++++++++++++++
 drivers/input/touchscreen/hx-algo.c           | 455 +++++++++
