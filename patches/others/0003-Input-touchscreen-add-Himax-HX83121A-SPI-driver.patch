+	&dev_attr_cmf_max_correction.attr,
+	&dev_attr_iir_enabled.attr,
+	&dev_attr_iir_decay_weight.attr,
+	&dev_attr_iir_decay_step.attr,
+	&dev_attr_iir_noise_floor.attr,
