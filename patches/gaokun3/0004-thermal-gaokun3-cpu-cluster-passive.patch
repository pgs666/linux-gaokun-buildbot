From: "github-actions[bot]" <github-actions[bot]@users.noreply.github.com>
Date: Sat, 22 Aug 2026 22:12:21 +0800
Subject: [PATCH] thermal: gaokun3: throttle hottest CPU cluster at 80C

---
 .../boot/dts/qcom/sc8280xp-huawei-gaokun3.dts | 138 +++++++++++++++++-
 1 file changed, 137 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
index 52dbfa79a..cd19564e8 100644
--- a/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-huawei-gaokun3.dts
@@ -221,6 +221,142 @@ linux,cma {
 	};
 
 	thermal-zones {
+		cpu0-thermal {
+			trips {
+				cpu0_passive: cpu-passive {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu0_passive>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		cpu1-thermal {
+			trips {
+				cpu1_passive: cpu-passive {
