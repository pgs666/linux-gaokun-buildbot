+				};
+			};
+		};
+
 		ec-temp1-thermal {
 			polling-delay = <1000>;
 			polling-delay-passive = <250>;
@@ -229,7 +365,7 @@ ec-temp1-thermal {
 
 			trips {
 				ec_temp1_passive: trip-point0 {
-					temperature = <80000>;
+					temperature = <90000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};
