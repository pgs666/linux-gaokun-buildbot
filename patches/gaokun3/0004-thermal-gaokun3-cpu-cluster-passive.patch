+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		cpu3-thermal {
+			trips {
+				cpu3_passive: cpu-passive {
+					temperature = <80000>;
+					hysteresis = <5000>;
